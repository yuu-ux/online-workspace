# =============================================================================
# Online Workspace - ローカル開発用環境変数テンプレート
# =============================================================================
# このファイルを .env にコピーしてから、各パスワードとキーを変更してください。
#
#   cp .env.sample .env
#
# .env には実際の秘密情報を設定します。.env はGit管理対象外です。
# パスワードは推測されにくい値を使用し、共有リポジトリへコミットしないでください。

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# BackendコンテナとPostgreSQLコンテナが共通して使用するデータベース設定です。
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-postgres-password
# ホスト側からPostgreSQLへ接続するポートです。
POSTGRES_HOST_PORT=5432

# -----------------------------------------------------------------------------
# Backend / Frontend / Proxy
# -----------------------------------------------------------------------------
# Backendのホスト公開ポートです。
BACKEND_HOST_PORT=8080
# Frontend開発サーバー、WebSocketモック、Nginxの公開ポートです。
FRONTEND_PORT=5173
WS_MOCK_PORT=8081
PROXY_HTTP_PORT=8088
PROXY_HTTPS_PORT=8443

# Spring SecurityのCookie設定です。ローカルHTTPS利用時はsecure=trueを推奨します。
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=lax

# Prometheusの管理APIを保護するキーです。空欄にせず変更してください。
MANAGEMENT_API_KEY=change-this-management-api-key
# APIキー保護を有効にする場合に使用します。不要な場合は空欄のままにできます。
APP_API_KEY=
# APP_API_KEY利用時のAPIプリンシパル名です。
APP_API_KEY_PRINCIPAL=
# 1分あたりのAPIレート制限です。
API_RATE_LIMIT_REQUESTS_PER_MINUTE=60

# -----------------------------------------------------------------------------
# Elasticsearch / Logstash / Kibana
# -----------------------------------------------------------------------------
# Elasticsearchのelasticユーザーの初回パスワードです。
# 既存のelasticsearch_data volumeがある場合は、初回作成時の値と一致させてください。
ELASTIC_PASSWORD=change-this-elastic-password
# ElasticsearchとKibanaのホスト公開ポートです。
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601

# -----------------------------------------------------------------------------
# Prometheus / Grafana
# -----------------------------------------------------------------------------
# Prometheusのデータ保持期間です。
PROMETHEUS_RETENTION=15d
# Grafana管理者のログイン情報です。
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
